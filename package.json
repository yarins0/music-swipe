{
  "name": "music-swipe",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "test": "jest --watchAll=false",
    "build": "tsc --noEmit",
    "graph": "graphify update .",
    "graph:watch": "graphify watch ."
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "0.4.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.46.0",
    "expo": "~52.0.0",
    "expo-audio": "~0.3.5",
    "expo-auth-session": "~6.0.3",
    "expo-checkbox": "~3.0.0",
    "expo-constants": "~17.0.3",
    "expo-crypto": "~14.0.1",
    "expo-font": "56.0.5",
    "expo-image": "~2.0.1",
    "expo-router": "~4.0.17",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.1",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "0.19.13",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "12.4.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint-config-expo": "^55.0.1",
    "eslint-plugin-rulesdir": "^0.2.2",
    "jest": "^29.7.0",
    "jest-expo": "52.0.6",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "@xmldom/xmldom": ">=0.8.13",
    "tar": ">=7.5.11"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/(?!.*native-win32)|@expo-google-fonts|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock"
    }
  }
}
