{
  "expo": {
    "name": "MusicSwipe",
    "slug": "music-swipe",
    "version": "1.0.0",
    "scheme": "music-swipe",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.yourcompany.musicswipe",
      "supportsTablet": false
    },
    "android": {
      "package": "com.yourcompany.musicswipe",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "spotifyClientId": "",
      "backendUrl": "http://localhost:3000"
    }
  }
}
