# Mobile app environment variables (Expo)
# Copy this to .env.local — Expo reads EXPO_PUBLIC_* vars at build time.
# Never commit .env.local

# ── Spotify ──────────────────────────────────────────────────────────────────
# From: https://developer.spotify.com/dashboard → your app → Settings
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id

# ── Backend ──────────────────────────────────────────────────────────────────
# URL of your running Express backend (see backend/.env.example)
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000
