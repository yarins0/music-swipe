# Backend environment variables (Express)
# Copy this to backend/.env — never commit it.

# ── Supabase ─────────────────────────────────────────────────────────────────
# From: https://supabase.com/dashboard → your project → Settings → API

# Project URL (e.g. https://abcdefgh.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# "service_role" secret key — under "Project API keys" (NOT the anon key)
# Keep this secret — it has full DB access and bypasses Row Level Security
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anon/public key — safe to expose, used for client-side queries if needed
SUPABASE_ANON_KEY=your-anon-key

# ── Database (direct Postgres) ────────────────────────────────────────────────
# From: Supabase dashboard → Settings → Database → Connection string → URI
# Use this to run schema.sql directly: psql "$DATABASE_URL" -f backend/src/db/schema.sql
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── Spotify ──────────────────────────────────────────────────────────────────
# From: https://developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# Comma-separated list of allowed CORS origins (mobile dev URL or your domain)
ALLOWED_ORIGINS=http://localhost:3000,exp://localhost:19000

# Global API rate limiting (optional — sensible defaults applied if unset)
# Max requests per window per user (or per IP for unauthenticated routes). Default: 100
RATE_LIMIT_MAX=100
# Rate-limit window in milliseconds. Default: 60000 (1 minute)
RATE_LIMIT_WINDOW_MS=60000